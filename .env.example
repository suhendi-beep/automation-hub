# ══════════════════════════════════════════════════════════
#  MS Command Center — Environment Configuration
#  Semua nilai sensitif dikelola via AWS SSM Parameter Store.
#  Path SSM: /portal-report/<KEY>
#  Nilai di sini hanya FALLBACK jika SSM tidak tersedia.
# ══════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────
FLASK_ENV=production
# Set FLASK_DEBUG=1 hanya untuk development lokal.
FLASK_DEBUG=0

# ── Redis ──────────────────────────────────────────────────
# Production: simpan sebagai SecureString di /portal-report/REDIS_URL.
# docker-compose menyediakan service "redis" untuk development lokal.
REDIS_URL=redis://redis:6379/0

# ── PostgreSQL ─────────────────────────────────────────────
# Dipakai oleh service db, migrate, dan backend. DB tidak diekspos ke host.
# Isi DB_PASSWORD dengan nilai kuat; jangan commit nilai aslinya.
DB_HOST=db
DB_PORT=5432
DB_NAME=automation_hub
DB_USER=automation
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
ACTIVITY_MAX_ROWS=5000

# ── SSM Config ─────────────────────────────────────────────
SSM_PREFIX=/portal-report
AWS_REGION=ap-southeast-1

# ── Secrets (diambil dari SSM saat runtime) ────────────────
# Isi HANYA jika SSM tidak tersedia (fallback lokal/dev).
SECRET_KEY=
GRAFANA_URL=https://monitoring.ilcs.co.id
GRAFANA_USER=
GRAFANA_PASS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated recipient list for scheduled reports.
EMAIL_TO=

# ── Authentication ─────────────────────────────────────────
# Bootstrap admin hanya dipakai saat tabel users masih kosong.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_TOKEN_MAX_AGE=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ── CORS ───────────────────────────────────────────────────
# Kosongkan untuk production (frontend di-proxy same-origin via nginx).
# Untuk dev dengan origin terpisah: http://localhost:5173
CORS_ORIGINS=

# ── Alerts ─────────────────────────────────────────────────
ESKALASI_TTL_DAYS=7
