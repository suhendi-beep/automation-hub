# ══════════════════════════════════════════════════════════
#  Portal Report — Environment Configuration
#  PENTING: Semua nilai sensitif dikelola via AWS SSM Parameter Store.
#  Path SSM: /portal-report/<KEY>
#  Jalankan push_secrets_to_ssm.py untuk upload credential ke SSM.
#  Nilai di sini hanya sebagai FALLBACK jika SSM tidak tersedia.
# ══════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────
FLASK_ENV=production

# ── Redis (external) ───────────────────────────────────────
# Channel 8 pada Redis server di 172.19.10.143
REDIS_URL=redis://172.19.10.143:6379/8

# ── SSM Config ─────────────────────────────────────────────
# Prefix path di AWS SSM Parameter Store
SSM_PREFIX=/portal-report
# Region AWS — dipakai juga untuk NIKP reporting
AWS_REGION=ap-southeast-1

# ── Secrets (diambil dari SSM saat runtime) ────────────────
# Nilai di bawah ini TIDAK diisi — ambil dari SSM.
# Isi HANYA jika SSM tidak tersedia (fallback lokal/dev).
SECRET_KEY=
GRAFANA_USER=
GRAFANA_PASS=
GRAFANA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_TO=
